OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL_RESEARCH=qwen2.5:latest
OLLAMA_MODEL_COPY=qwen2.5-coder:3b
OLLAMA_MODEL_FAST=qwen2.5:1.5b
OLLAMA_MODEL_STANDARD=qwen2.5:1.5b
OLLAMA_MODEL_PREMIUM=qwen2.5-coder:3b
OLLAMA_MODEL_CODER=qwen2.5-coder:3b
OLLAMA_AGENT_MODEL_CONTENT_WRITER_01=qwen2.5-coder:3b

# AGENT HARDENING & TIMEOUTS (ConfiguraciÃ³n optimizada para 4GB VRAM)
AI_FACADE_TIMEOUT_MS=300000
AI_FACADE_FAILURE_COOLDOWN_MS=5000
WRITER_TIMEOUT_MS=600000
WRITER_RETRY_TIMEOUT_MS=300000
ARCHITECT_TIMEOUT_MS=300000
CORRECTOR_TIMEOUT_MS=300000
ANALYST_TIMEOUT_MS=180000

# INPUT RIGOR & PUBLISH GATE
STRICT_COMMAND_MODE=true
MIN_QUALITY_SCORE_TO_PUBLISH=75
PUBLISH_HARD_BLOCK_ON_FAIL=true

# MODEL ROUTER HARDWARE PROFILE
HARDWARE_VRAM_GB=4
MODEL_ROUTER_ENABLED=true
MODEL_ROUTER_PROFILE=premium-local
OLLAMA_PREFLIGHT_ENABLED=true
PRIMARY_MODEL_TIER=premium

# Overrides especÃ­ficos solicitados por el usuario
AGENT_MODEL_OVERRIDES_JSON={ "Spanish_Linguistic_Corrector_V2": "qwen2.5:latest" }

OLLAMA_MODEL_ALIAS_JSON={ "gemma3:4b":["qwen2.5:latest","qwen2.5:1.5b"], "qwen2.5:7b-instruct-q4_K_M":["qwen2.5:latest","qwen2.5:1.5b"], "qwen2.5-coder:3b-instruct":["qwen2.5-coder:3b"] }

GPU_VRAM_GB=4
TOTAL_RAM_GB_OVERRIDE=16
DATABASE_PATH=./maestro.db
REDIS_HOST=localhost
REDIS_PORT=6379
DEBUG_MODE=true
# WP_APPLICATION_PASSWORD=
# SERP_API_KEY=

# --- CONFIGURACION COMFYUI ---
COMFY_ENABLED=true
COMFY_BASE_URL=http://127.0.0.1:8000
COMFY_UNET_MODEL=flux1-schnell-Q2_K.gguf
COMFY_CLIP_MODEL=clip_l.safetensors
COMFY_T5_MODEL=t5xxl_fp8_e4m3fn.safetensors
COMFY_VAE_MODEL=flux-vae-bf16.safetensors
COMFY_OUTPUT_DIR=./assets_generated/page-images
COMFY_PUBLIC_BASE_URL=/assets_generated/page-images
COMFY_POLL_INTERVAL_MS=5000
COMFY_MAX_WAIT_MS=1200000
COMFY_WORKFLOW_HERO=./workflows/comfy/flux2-klein-hero.json
COMFY_WORKFLOW_EDITORIAL=./workflows/comfy/flux2-klein-editorial.json
COMFY_FORCE_LOCAL_REALISM=true
COMFY_NEGATIVE_PROMPT=text, watermark, logo, deformed hands, extra fingers, duplicated tools, blurry, oversaturated, low quality, cgi, cartoon, 3d render, illustration

# --- SOPORTE LoRA ---
COMFY_LORA_ENABLED=true
COMFY_LORA_MAX_PER_IMAGE=2
COMFY_LORA_DEFAULT_STRENGTH=0.8
COMFY_LORA_DEFAULT_CLIP_STRENGTH=0.8
COMFY_LORA_STRICT_MODE=false

# --- CONFIGURACION ESTABILIDAD PIPELINE ---
AI_FACADE_ALLOW_MOCKS=false
FAIL_ON_DEGRADED_PLAN=false
QUALITY_AUDIT_FAIL_OPEN=false
PIPELINE_FAST_DEBUG=true
QUALITY_GATE_FORCE_PASS=false
PIPELINE_SOFT_MODE=true
FORCE_DETERMINISTIC_PLANNING=false

# DASHBOARD SECURITY
DASHBOARD_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8085,http://127.0.0.1:8085
DASHBOARD_AUTH_TOKEN=debug_token_123
DASHBOARD_RATE_MAX=1000

GRAVITY_DETERMINISTIC_AI_KERNEL=true
GRAVITY_AI_CREATIVE_MODE=false
GRAVITY_SUPER_DELIVERY_LOCK=true
GRAVITY_LEGACY_LAYERED_CSS=false
GRAVITY_PRODUCTION_SAFE_MODE=true
