# Runtime
NODE_ENV=development
DEBUG_MODE=false
PIPELINE_SOFT_MODE=false
QUALITY_AUDIT_FAIL_OPEN=false
AI_FACADE_ALLOW_MOCKS=false
FAIL_ON_DEGRADED_PLAN=true

# Dashboard security
DASHBOARD_PORT=8081
DASHBOARD_AUTH_TOKEN=change-me-long-random-token
DASHBOARD_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
DASHBOARD_RATE_WINDOW_MS=60000
DASHBOARD_RATE_MAX=120

# Models
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL_RESEARCH=qwen2.5:1.5b
OLLAMA_MODEL_COPY=qwen2.5:latest
OLLAMA_MODEL_FAST=qwen2.5:1.5b
OLLAMA_MODEL_STANDARD=qwen2.5:1.5b
OLLAMA_MODEL_PREMIUM=qwen2.5:latest
OLLAMA_MODEL_CODER=qwen2.5-coder:1.5b

# Database and services
DATABASE_PATH=./maestro.db
REDIS_HOST=localhost
REDIS_PORT=6379

# Images
COMFY_ENABLED=false
COMFY_BASE_URL=http://127.0.0.1:8188
COMFY_OUTPUT_DIR=./assets_generated/page-images
COMFY_PUBLIC_BASE_URL=/assets_generated/page-images
