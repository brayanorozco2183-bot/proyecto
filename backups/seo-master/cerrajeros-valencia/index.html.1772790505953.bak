<!DOCTYPE html><html lang="es"><head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cerrajeros de Urgencia en Valencia - Cerrajería Maestra</title>
    <meta name="description" content="Confía en nuestros cerrajeros profesionales para soluciones rápidas y seguras en Valencia. Atención inmediata, técnicas avanzadas y garantía por escrito.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800;900&amp;display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #D4AF37;
            --primary-dark: #b5952f;
            --secondary: #0A192F;
            --accent: #38bdf8;
            --text: #334155;
            --text-light: #64748b;
            --bg: #ffffff;
            --bg-alt: #f8fafc;
            --border: #e2e8f0;
            --radius: 12px;
            --shadow: 0 10px 30px -10px rgba(0,0,0,0.1);
            --container: 1200px;
            --gap: clamp(20px, 4vw, 40px);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { 
            font-family: 'Inter', sans-serif; 
            color: var(--text); 
            background: var(--bg); 
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
            font-size: clamp(1rem, 1.1vw, 1.2rem);
        }

        /* NAVIGATION - Glassmorphism */
        nav {
            position: sticky;
            top: 0;
            z-index: 1000;
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 2px solid var(--primary);
            transition: all 0.3s ease;
        }
        .nav-inner {
            max-width: var(--container);
            margin: auto;
            padding: 15px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: clamp(10px, 2vw, 20px);
            width: 100%;
        }
        .logo { 
            font-size: clamp(1.2rem, 2.5vw, 1.6rem); 
            font-weight: 900; 
            color: var(--secondary); 
            text-transform: uppercase; 
            letter-spacing: -0.5px;
        }
        .logo span { color: var(--primary); }
        .nav-links { display: flex; gap: clamp(15px, 2vw, 30px); list-style: none; }
        .nav-links a { 
            text-decoration: none; 
            color: var(--text); 
            font-weight: 600; 
            font-size: 0.95rem; 
            transition: color 0.3s;
            position: relative;
        }
        .nav-links a:hover { color: var(--primary); }
        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 0;
            height: 2px;
            background: var(--primary);
            transition: width 0.3s;
        }
        .nav-links a:hover::after { width: 100%; }

        .nav-cta {
            background: var(--primary);
            color: var(--secondary);
            padding: clamp(8px, 1.5vw, 12px) clamp(10px, 2vw, 24px);
            border-radius: 8px;
            text-decoration: none;
            font-weight: 800;
            font-size: clamp(0.75rem, 1.2vw, 0.9rem);
            box-shadow: 0 4px 15px rgba(212, 175, 55, 0.2);
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            white-space: nowrap;
        }
        .nav-cta:hover { transform: scale(1.05); box-shadow: 0 10px 25px rgba(212, 175, 55, 0.4); }

        @media (max-width: 600px) {
            .nav-cta span.cta-text { display: none; }
        }
        @media (max-width: 400px) {
            .nav-inner { padding: 10px 15px; gap: 8px; }
            .logo { font-size: 1.1rem; flex-shrink: 1; min-width: 0; }
            .nav-cta { padding: 8px 12px; flex-shrink: 0; }
        }
        @media (max-width: 350px) {
            .logo { font-size: 0.95rem; }
            .logo span { display: none; }
        }
        @media (max-width: 300px) {
            .logo { font-size: 0.85rem; }
            .nav-inner { padding: 8px 10px; }
        }

        /* HERO - Balanced Fluidity */
        header.hero {
            background: radial-gradient(circle at top right, #112240, var(--secondary));
            padding: clamp(80px, 12vw, 140px) 20px;
            color: white;
            text-align: center;
        }
        .hero h1 { 
            font-size: clamp(2.2rem, 5vw, 4.2rem); 
            font-weight: 950; 
            line-height: 1.1; 
            margin-bottom: 25px; 
            letter-spacing: -2px;
            max-width: 1000px;
            margin-left: auto;
            margin-right: auto;
        }
        .hero p { 
            font-size: clamp(1.1rem, 1.8vw, 1.4rem); 
            opacity: 0.95; 
            max-width: 800px; 
            margin: 0 auto 45px; 
            line-height: 1.5;
        }
        .hero-btn {
            display: inline-flex;
            align-items: center;
            gap: 15px;
            background: var(--primary);
            color: var(--secondary);
            padding: clamp(16px, 2vw, 22px) clamp(30px, 4vw, 55px);
            border-radius: 10px;
            font-size: clamp(1.1rem, 1.5vw, 1.4rem);
            font-weight: 900;
            text-decoration: none;
            box-shadow: 0 20px 40px -10px rgba(212, 175, 55, 0.5);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .hero-btn:hover { transform: translateY(-5px) scale(1.02); box-shadow: 0 30px 60px -15px rgba(212, 175, 55, 0.6); }

        /* SECTIONS & TITLES */
        section { padding: var(--gap) 0; width: 100%; position: relative; }
        .section-inner { max-width: var(--container); margin: auto; padding: 0 20px; }
        .section-title { 
            font-size: clamp(1.8rem, 4vw, 2.8rem); 
            font-weight: 900; 
            color: var(--secondary); 
            margin-bottom: 60px; 
            text-align: center; 
            position: relative;
            letter-spacing: -1px;
        }
        .section-title::after { content: ''; display: block; width: clamp(40px, 6vw, 80px); height: 5px; background: var(--primary); margin: 20px auto 0; border-radius: 5px; }

        /* GRID & CARDS */
        .grid { 
            display: grid; 
            grid-template-columns: repeat(auto-fit, minmax(clamp(280px, 25vw, 350px), 1fr)); 
            gap: var(--gap); 
        }
        .card {
            background: white;
            padding: clamp(20px, 3vw, 45px);
            border-radius: var(--radius);
            border: 1px solid var(--border);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 10px 30px -15px rgba(0,0,0,0.05);
            overflow-wrap: break-word;
            word-wrap: break-word;
            hyphens: auto;
        }
        .card:hover { transform: translateY(-8px); box-shadow: 0 30px 60px -20px rgba(0,0,0,0.1); border-color: var(--primary); }
        .card .icon { font-size: clamp(2.5rem, 4vw, 3.5rem); margin-bottom: 25px; display: block; }
        .card h3 { font-size: clamp(1.3rem, 1.8vw, 1.6rem); margin-bottom: 15px; color: var(--secondary); font-weight: 800; line-height: 1.2; }
        .card p { color: var(--text-light); font-size: 0.95rem; }

        /* CONTENT & INTERVENTIONS */
        .content-block { max-width: 1000px; margin: 0 auto; }
        .premium-content h2 { 
            margin: 60px 0 30px; 
            font-size: clamp(1.6rem, 3vw, 2.2rem); 
            color: var(--secondary); 
            border-left: clamp(6px, 1vw, 10px) solid var(--primary); 
            padding-left: 25px; 
            font-weight: 900;
        }
        .premium-content p { margin-bottom: 30px; line-height: 1.8; }
        .premium-content ul { 
            list-style: none; 
            padding: 25px clamp(15px, 4vw, 35px); 
            background: var(--bg-alt); 
            border-radius: 15px; 
            margin-bottom: 40px; 
            border: 1px solid var(--border);
        }
        .premium-content li { 
            position: relative; 
            padding-left: 35px; 
            margin-bottom: 15px; 
            font-weight: 500;
            color: var(--text);
        }
        .premium-content li::before { 
            content: '✓'; 
            position: absolute; 
            left: 0; 
            color: var(--primary); 
            font-weight: 950; 
            font-size: 1.2rem;
            line-height: 1;
        }
        .premium-content li:last-child { margin-bottom: 0; }

        .intervention-card {
            background: #ffffff;
            border-left: 6px solid var(--primary);
            padding: clamp(20px, 3vw, 35px);
            margin-bottom: 35px;
            border-radius: 0 15px 15px 0;
            box-shadow: 0 15px 40px -15px rgba(0,0,0,0.08);
            transition: all 0.3s ease;
        }
        .intervention-card:hover { transform: scale(1.01) translateX(10px); }
        .intervention-card h3 { font-size: clamp(1.2rem, 1.8vw, 1.5rem); margin-bottom: 15px; display: flex; align-items: center; gap: 15px; color: var(--secondary); }

        /* TABLES - Advanced Mobile Response */
        .table-container { margin: 50px 0; border-radius: 12px; overflow: hidden; box-shadow: 0 20px 50px -20px rgba(0,0,0,0.1); border: 1px solid var(--border); }
        table { width: 100%; border-collapse: collapse; }
        th { background: var(--secondary); color: white; padding: clamp(15px, 2vw, 25px); text-align: left; font-weight: 800; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.15em; }
        td { padding: clamp(15px, 2vw, 22px); border-bottom: 1px solid var(--border); font-size: clamp(0.95rem, 1.1vw, 1.1rem); }
        
        @media (max-width: 650px) {
            .table-container, table, thead, tbody, th, td, tr { display: block; }
            thead tr { position: absolute; top: -9999px; left: -9999px; }
            tr { padding: 20px 15px; border-bottom: 2px solid var(--border); background: white !important; }
            td { border: none; position: relative; text-align: left; padding: 5px 0; margin-bottom: 5px; }
            td:first-child { 
                font-weight: 800; 
                color: var(--secondary); 
                font-size: 1rem; 
                padding-bottom: 5px;
                display: flex;
                align-items: center;
                gap: 10px;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }
            td:first-child::before { 
                content: '→'; 
                color: var(--primary); 
                font-weight: 950;
            }
            td:last-child { 
                padding-left: 25px;
                color: var(--text);
                font-weight: 600;
                font-size: 1.1rem;
                margin-bottom: 15px;
            }
            td:before { 
                display: none; 
            }
        }

        /* FAQ - Elegant Accordion Vibes */
        #faq { background: var(--secondary); color: white; width: 100%; }
        .faq-inner { max-width: 900px; margin: 0 auto; padding: 0 20px; }
        .faq-item { border-bottom: 1px solid rgba(255,255,255,0.1); padding: clamp(25px, 4vw, 40px) 0; }
        .faq-q { font-weight: 900; font-size: clamp(1.1rem, 1.6vw, 1.4rem); color: var(--primary); margin-bottom: 15px; display: flex; gap: 20px; }
        .faq-a { color: rgba(255,255,255,0.85); padding-left: clamp(20px, 5vw, 45px); font-size: clamp(1rem, 1.15vw, 1.15rem); line-height: 1.7; padding-bottom: 10px; }

        /* FOOTER & NETWORK */
        .network-grid { 
            display: grid; 
            grid-template-columns: repeat(auto-fit, minmax(clamp(180px, 20vw, 250px), 1fr)); 
            gap: 20px; 
            margin-top: 50px; 
        }
        .network-item { 
            padding: clamp(15px, 2vw, 22px); 
            background: white; 
            border: 2px solid var(--border); 
            border-radius: 10px; 
            font-weight: 700; 
            font-size: 0.95rem;
            text-align: center;
            transition: all 0.3s;
        }
        .network-item:hover { border-color: var(--primary); background: var(--bg-alt); }

        /* ABOUT SECTION ENHANCEMENT */
        .about-section { background: var(--secondary); color: white; padding: 100px 0; width: 100%; }
        .about-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(clamp(250px, 30vw, 450px), 1fr)); gap: 50px; max-width: var(--container); margin: auto; padding: 0 20px; }
        .about-info h2 { color: var(--primary); margin-bottom: 25px; font-size: clamp(2rem, 3.5vw, 2.5rem); font-weight: 900; }
        .about-stats { display: flex; gap: 40px; margin-top: 40px; }
        .stat-item { border-left: 4px solid var(--primary); padding-left: 20px; }
        .stat-num { font-size: 2.2rem; font-weight: 900; display: block; color: var(--primary); }
        .stat-label { font-size: 0.9rem; opacity: 0.8; text-transform: uppercase; letter-spacing: 1px; }
        .about-badges { display: flex; gap: 15px; margin-top: 45px; flex-wrap: wrap; }
        .badge { background: rgba(255,255,255,0.08); padding: 10px 20px; border-radius: 6px; font-size: 0.85rem; font-weight: 700; border: 1px solid rgba(255,255,255,0.15); transition: all 0.3s; }
        .badge:hover { background: rgba(255,255,255,0.15); border-color: var(--primary); }

        footer { background: #020617; color: white; padding: 100px 20px 50px; text-align: center; }
        .footer-logo { font-size: 2.2rem; font-weight: 950; margin-bottom: 25px; letter-spacing: -1px; }

        /* MOBILE OVERRIDES */
        @media (max-width: 900px) {
            .nav-links { display: none; }
            .hero h1 { letter-spacing: -1px; }
        }
    </style>
